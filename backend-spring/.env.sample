MONGO_URL=
PORT=3000
CLIENT_URL=http://localhost:3043,https://ludo-king-frontend.onrender.com
SESSION_SECRET=ludo-dev-session-secret-change-me
OAUTH_ENABLED=false
GOOGLE_KEY=
GOOGLE_SECRET=
GITHUB_KEY=
GITHUB_SECRET=
REDIS_URL=

# --- Aakda platform ---
CORS_ALLOWED_ORIGINS=https://www.aakda.in,https://aakda.in,http://localhost:5173
PLATFORM_SHARED_SECRET=

# --- Real wallet (Model A: entry fee per match) ---
# Aakda Node wallet base (source of truth). Blank = wallet calls skipped / local free play.
AAKDA_WALLET_BASE_URL=https://api.aakda.in
LUDO_WALLET_ENABLED=true
GAME_ID=LUDO
ENTRY_FEE=10
BET_OPTIONS=10,20,50,100
# Leave both 0 for winner-takes-pot−rake. Or set WIN_PAYOUT=25 / WIN_MULTIPLIER=2
WIN_PAYOUT=0
WIN_MULTIPLIER=0
# House rake per paid seat (2P→2×fee, 4P→4×fee; bots count as paid seats)
PLATFORM_FEE_PER_PLAYER=10

# Admin login (Ludo King admin UI)
ADMIN_EMAIL=admin@ludo.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Ludo King Admin

# Hard bot only: 80% exact capture dice when kill reachable within 1–6; false = always random
SMART_BOT_DICE_ASSIST=true

# Human only: gradual six boost while all four pawns remain in jail (server-side)
HUMAN_JAIL_ASSIST=true
MAX_ASSIST_ATTEMPTS=6
JAIL_ASSIST_NORMAL_ROLLS=2
JAIL_ASSIST_BOOST_STEP=0.05
JAIL_ASSIST_MAX_SIX_PROB=0.45

# Human only: smart six boost when all jailed and opponent is near starting path
HUMAN_JAIL_EXIT_ASSIST=true
HUMAN_JAIL_EXIT_ASSIST_CHANCE=70
